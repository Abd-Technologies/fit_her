      "id": "pcos",
      "title": "PCOS",
      "enabledByDefault": false,
      "tracking": ["cravings", "skin_hair", "cycle_range"],
      "nutritionRules": ["low_gi", "steady_protein"],
      "workoutModifiers": ["strength_plus_moderate_cardio", "fewer_phase_nudges"],
