      "workoutModifiers": ["staged_5_to_15", "stricter_c_section_stages"],
      "notificationCapPerDay": 1,
      "doctorReportSection": "Postpartum recovery summary.",
      "safetyPrompt": "pending_doctor_review: Get clearance before returning to impact work.",
      "communitySpace": "postpartum_circle",
      "disableCyclePredictionUntilReturn": true
    },
    {
      "id": "thyroid",
      "title": "Thyroid",
      "enabledByDefault": false,
      "tracking": ["thyroid_type", "med_timing", "optional_labs"],
